{
  "manifest_version": 3,
  "name": "CCG Web UI Companion",
  "version": "1.0.0",
  "description": "Open CCG task pages in background tabs and close only those task pages when finished.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "CCG task tabs: click to reconnect"}
}
